# ============================================================================
# EmberVault Configuration Template (.env.example)
# Generated from CONFIG_REGISTRY. Do not edit manually.
# ============================================================================

# --- COMMON SETTINGS ---
# Ambiente di esecuzione: 'dev' o 'prod'.
EMBERVAULT_ENV=dev

# Livello minimo di logging (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# [Overridable da GUI]
EMBERVAULT_LOG_LEVEL=INFO

# Formato dei log: 'json' (produzione) o 'console' (sviluppo colorato).
# [Overridable da GUI]
EMBERVAULT_LOG_FORMAT=json

# Abilita la modalità demo (attivabile esclusivamente da variabile d'ambiente) con credenziali precompilate e simulazione remotes.
EMBERVAULT_DEMO_MODE=false

# --- DB SETTINGS ---
# URL completo di connessione a PostgreSQL (alternativa ai singoli parametri POSTGRES_*).
# Supporta anche DATABASE_URL_FILE per Docker Secrets
DATABASE_URL=postgresql+psycopg://embervault:secret@postgres:5432/embervault

# Host del server PostgreSQL.
POSTGRES_HOST=postgres

# Porta del server PostgreSQL.
POSTGRES_PORT=5432

# Nome del database PostgreSQL.
POSTGRES_DB=embervault

# Username utente PostgreSQL.
POSTGRES_USER=embervault

# Password per la connessione al database PostgreSQL.
# Supporta anche POSTGRES_PASSWORD_FILE per Docker Secrets
POSTGRES_PASSWORD=postgres_dev_password_change_me

# --- SECURITY SETTINGS ---
# Chiave simmetrica master AES-256 (32 byte esadecimali o Base64) per la crittografia a riposo.
# Supporta anche EMBERVAULT_MASTER_KEY_FILE per Docker Secrets
EMBERVAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Identificativo univoco della chiave master attiva per rotazione futura.
EMBERVAULT_MASTER_KEY_ID=v1

# Elenco di chiavi master secondarie/storiche per rotazione (formato 'id1:key1,id2:key2').
# Supporta anche EMBERVAULT_MASTER_KEYS_FILE per Docker Secrets
EMBERVAULT_MASTER_KEYS=v1:old_key_32_chars_minimum__,v2:new_key_32_chars_minimum__

# Secret key per la firma crittografica delle sessioni web Flask.
# Supporta anche EMBERVAULT_SECRET_KEY_FILE per Docker Secrets
EMBERVAULT_SECRET_KEY=super_secret_session_signing_key_32_chars_min

# Token di autenticazione per le chiamate HTTP tra App e Orchestrator.
# Supporta anche EMBERVAULT_INTERNAL_API_TOKEN_FILE per Docker Secrets
EMBERVAULT_INTERNAL_API_TOKEN=internal_api_token_very_secure_random_string_32

# --- APP SETTINGS ---
# Indirizzo IP di bind per il servizio Flask App.
EMBERVAULT_APP_BIND=0.0.0.0

# Porta HTTP di ascolto per il servizio App.
EMBERVAULT_APP_PORT=8080

# URL pubblico canonico utilizzato per link e redirect.
# [Overridable da GUI]
EMBERVAULT_PUBLIC_URL=http://localhost:8080

# URL canonico del Portale Pubblico (per link di condivisione).
# [Overridable da GUI]
EMBERVAULT_PORTAL_URL=http://localhost:8083

# Se True, forza il flag 'Secure' sui cookie di sessione (richiede HTTPS).
# [Overridable da GUI]
EMBERVAULT_SESSION_COOKIE_SECURE=false

# Lingua di default dell'interfaccia utente (default 'en').
# [Overridable da GUI]
EMBERVAULT_DEFAULT_LOCALE=en

# Numero di reverse proxy a monte per il corretto rilevamento di X-Forwarded-For.
# [Overridable da GUI]
EMBERVAULT_TRUSTED_PROXY_COUNT=0

# Elenco di proxy affidabili (IP o subnet CIDR separati da virgola, es. '192.168.1.1,10.0.0.0/8'). Se compilato, l'applicazione si fida dell'IP reale del client passato negli header X-Forwarded-For.
# [Overridable da GUI]
EMBERVAULT_TRUSTED_PROXIES=192.168.1.1,10.0.0.0/8

# Abilita funzionalità di debug/registrazione senza autenticazione (SOLO per sviluppo).
EMBERVAULT_DEV_NOAUTH=false

# Abilita autenticazione LDAP / Active Directory per gli utenti aziendali.
# [Overridable da GUI]
EMBERVAULT_LDAP_ENABLED=false

# URL del server LDAP/AD (es. ldaps://dc.azienda.local:636 o ldap://dc:389).
# [Overridable da GUI]
EMBERVAULT_LDAP_SERVER_URL=ldaps://dc.azienda.local:636

# Forza crittografia TLS (obbligatoria da policy M4; StartTLS su porta 389 o LDAPS su 636).
# [Overridable da GUI]
EMBERVAULT_LDAP_REQUIRE_TLS=true

# DN dell'account di servizio per la ricerca iniziale (es. CN=svc_ember,OU=Services,DC=azienda,DC=local).
# [Overridable da GUI]
EMBERVAULT_LDAP_BIND_DN=CN=svc_ember,OU=Services,DC=azienda,DC=local

# Password dell'account di servizio LDAP per il search bind.
# [Overridable da GUI]
EMBERVAULT_LDAP_BIND_PASSWORD=StrongServicePassword123!

# Base DN in cui risiedono gli utenti (es. DC=azienda,DC=local o OU=Users,DC=azienda,DC=local).
# [Overridable da GUI]
EMBERVAULT_LDAP_BASE_DN=DC=azienda,DC=local

# Filtro LDAP per individuare l'utente. Il token {username} viene sostituito con l'input.
# [Overridable da GUI]
EMBERVAULT_LDAP_USER_FILTER=(&(objectClass=person)(|(sAMAccountName={username})(uid={username})))

# Nome dell'attributo utente contenente i gruppi di appartenenza (es. memberOf).
# [Overridable da GUI]
EMBERVAULT_LDAP_GROUP_ATTRIBUTE=memberOf

# Gruppo LDAP (CN o DN completo) associato al ruolo di sistema 'admin'.
# [Overridable da GUI]
EMBERVAULT_LDAP_ADMIN_GROUP=CN=EmberAdmins,OU=Groups,DC=azienda,DC=local

# Gruppo LDAP (CN o DN completo) associato al ruolo di sistema 'operator'.
# [Overridable da GUI]
EMBERVAULT_LDAP_OPERATOR_GROUP=CN=EmberOperators,OU=Groups,DC=azienda,DC=local

# Gruppo LDAP (CN o DN completo) associato al ruolo di sistema 'viewer'.
# [Overridable da GUI]
EMBERVAULT_LDAP_VIEWER_GROUP=CN=EmberViewers,OU=Groups,DC=azienda,DC=local

# Timeout di connessione e ricerca verso il server LDAP in secondi.
# [Overridable da GUI]
EMBERVAULT_LDAP_CONNECT_TIMEOUT_S=5

# Verifica validità del certificato TLS del server LDAP/AD (disattivare per consentire CA non fidate / self-signed).
# [Overridable da GUI]
EMBERVAULT_LDAP_VALIDATE_CERT=true

# Certificato Root CA o catena CA di dominio in formato PEM (inclusi -----BEGIN CERTIFICATE----- e -----END CERTIFICATE-----).
# [Overridable da GUI]
EMBERVAULT_LDAP_CA_CERT_PEM=-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----

# Abilita autenticazione OpenID Connect / Single Sign-On (es. PocketID).
# [Overridable da GUI]
EMBERVAULT_OIDC_ENABLED=false

# Nome del provider OIDC visualizzato nel pulsante di accesso (es. PocketID, Keycloak).
# [Overridable da GUI]
EMBERVAULT_OIDC_PROVIDER_NAME=PocketID

# URL base dell'Identity Provider OIDC (senza /.well-known/openid-configuration).
# [Overridable da GUI]
EMBERVAULT_OIDC_ISSUER_URL=https://pocketid.azienda.local

# Client ID registrato sull'Identity Provider OIDC.
# [Overridable da GUI]
EMBERVAULT_OIDC_CLIENT_ID=embervault

# Client Secret per lo scambio token (lasciare vuoto se client pubblico solo con PKCE).
# [Overridable da GUI]
EMBERVAULT_OIDC_CLIENT_SECRET=SecretKey123!

# Ambiti (scopes) OIDC richiesti separati da spazio.
# [Overridable da GUI]
EMBERVAULT_OIDC_SCOPES=openid profile email groups

# Nome del claim contenente lo username dell'utente (es. preferred_username, username, sub).
# [Overridable da GUI]
EMBERVAULT_OIDC_USERNAME_CLAIM=preferred_username

# Nome del claim contenente i gruppi/ruoli dell'utente (es. groups, roles).
# [Overridable da GUI]
EMBERVAULT_OIDC_GROUPS_CLAIM=groups

# Gruppo o ruolo OIDC mappato ad 'Administrator'.
# [Overridable da GUI]
EMBERVAULT_OIDC_ADMIN_GROUP=ember_admins

# Gruppo o ruolo OIDC mappato ad 'Operator'.
# [Overridable da GUI]
EMBERVAULT_OIDC_OPERATOR_GROUP=ember_operators

# Gruppo o ruolo OIDC mappato a 'Viewer'.
# [Overridable da GUI]
EMBERVAULT_OIDC_VIEWER_GROUP=ember_viewers

# Verifica certificato TLS dell'Identity Provider OIDC.
# [Overridable da GUI]
EMBERVAULT_OIDC_VALIDATE_CERT=true

# Certificato Root CA o catena CA dell'IdP OIDC in formato PEM (inclusi -----BEGIN CERTIFICATE----- e -----END CERTIFICATE-----).
# [Overridable da GUI]
EMBERVAULT_OIDC_CA_CERT_PEM=-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----

# 2FA richiesta se impostata per autenticazione OIDC (se disattivato, salta la 2FA per gli accessi OIDC).
# [Overridable da GUI]
EMBERVAULT_OIDC_ENFORCE_MFA=true

# Immagine di sfondo personalizzata (base64 data URI o URL) per la schermata di login.
# [Overridable da GUI]
EMBERVAULT_LOGIN_CUSTOM_BACKGROUND=data:image/jpeg;base64,...

# Nome personalizzato dell'applicazione (Whitelabel) visualizzato nella UI al posto di 'EmberVault'.
# [Overridable da GUI]
EMBERVAULT_CUSTOM_APP_NAME=MyBackupVault

# Logo personalizzato dell'applicazione (Whitelabel) in formato base64 data URI o URL.
# [Overridable da GUI]
EMBERVAULT_CUSTOM_LOGO=data:image/png;base64,...

# Nome personalizzato del portale pubblico visualizzato al posto di 'EmberVault public portal'.
# [Overridable da GUI]
EMBERVAULT_PORTAL_CUSTOM_APP_NAME=MyPortal Client Area

# Logo personalizzato del portale pubblico in formato base64 data URI o URL.
# [Overridable da GUI]
EMBERVAULT_PORTAL_CUSTOM_LOGO=data:image/png;base64,...

# Abilita o disabilita globalmente il portale pubblico e la generazione di link.
# [Overridable da GUI]
EMBERVAULT_PUBLIC_PORTAL_ENABLED=true

# Lingua predefinita per l'interfaccia cliente del portale pubblico (/share).
# [Overridable da GUI]
EMBERVAULT_PORTAL_LANGUAGE=en

# Abilita o disabilita globalmente il sistema di notifiche.
# [Overridable da GUI]
EMBERVAULT_NOTIFICATIONS_ENABLED=true

# --- ORCHESTRATOR SETTINGS ---
# Criterio di invio notifiche per i job: 'only_errors' (solo se ci sono errori) o 'always' (sempre al termine dell'esecuzione).
# [Overridable da GUI]
EMBERVAULT_NOTIFICATION_JOB_POLICY=only_errors

# Invia una notifica quando un proxy nodo di esecuzione passa allo stato offline.
# [Overridable da GUI]
EMBERVAULT_NOTIFICATION_PROXY_OFFLINE_ENABLED=true

# Invia una notifica quando sono disponibili aggiornamenti RClone per i nodi proxy.
# [Overridable da GUI]
EMBERVAULT_NOTIFICATION_RCLONE_UPDATE_ENABLED=true

# Abilita il controllo periodico della presenza di aggiornamenti di RClone sui proxy.
# [Overridable da GUI]
EMBERVAULT_RCLONE_AUTO_UPDATE_CHECK_ENABLED=true

# Intervallo in ore tra i controlli periodici degli aggiornamenti di RClone.
# [Overridable da GUI]
EMBERVAULT_RCLONE_AUTO_UPDATE_CHECK_INTERVAL_HOURS=24

# Versione semver minima richiesta per il container Proxy per essere considerato compatibile.
# [Overridable da GUI]
EMBERVAULT_MIN_PROXY_VERSION=1.0.0

# Intervallo in secondi tra i sondaggi di heartbeat verso ciascun proxy.
# [Overridable da GUI]
EMBERVAULT_HEARTBEAT_INTERVAL_S=15

# Numero di fallimenti consecutivi di heartbeat prima di marcare un proxy come offline.
# [Overridable da GUI]
EMBERVAULT_OFFLINE_AFTER_FAILURES=3

# Numero di successi consecutivi di heartbeat prima di riammettere un proxy come online.
# [Overridable da GUI]
EMBERVAULT_ONLINE_AFTER_SUCCESSES=2

# Limite globale di task concorrenti eseguiti (default vuoto = numero di proxy abilitati).
# [Overridable da GUI]
EMBERVAULT_GLOBAL_CONCURRENCY=

# Limite di default di task simultanei per singolo proxy.
# [Overridable da GUI]
EMBERVAULT_PER_PROXY_CONCURRENCY=1

# Limite di default di task simultanei per singolo job (default = limite globale).
# [Overridable da GUI]
EMBERVAULT_PER_JOB_CONCURRENCY=

# Policy di default per le esecuzioni missate quando non specificata nel job ('run_once', 'skip', 'fail').
# [Overridable da GUI]
EMBERVAULT_DEFAULT_MISSED_RUN_POLICY=run_once

# Policy di default per la gestione della sovrapposizione quando non specificata nel job ('skip', 'allow', 'cancel_previous').
# [Overridable da GUI]
EMBERVAULT_DEFAULT_OVERLAP_POLICY=skip

# Policy di default per le run pendenti o interrotte al riavvio quando non specificata nel job ('fail', 'retry').
# [Overridable da GUI]
EMBERVAULT_DEFAULT_PENDING_POLICY=fail

# Numero massimo di tentativi di esecuzione prima del fallimento permanente del task.
# [Overridable da GUI]
EMBERVAULT_TASK_MAX_ATTEMPTS=3

# Ritardo base in secondi per il backoff esponenziale dei tentativi falliti.
# [Overridable da GUI]
EMBERVAULT_RETRY_BASE_S=30

# Tetto massimo di attesa in secondi per il backoff esponenziale dei tentativi.
# [Overridable da GUI]
EMBERVAULT_RETRY_MAX_S=900

# Periodo di quarantena (cooldown) in secondi applicato a un proxy con errori infrastrutturali.
# [Overridable da GUI]
EMBERVAULT_PROXY_COOLDOWN_S=60

# Tempo massimo in stato ready in assenza di proxy online prima del fallimento del task.
# [Overridable da GUI]
EMBERVAULT_ASSIGNMENT_TIMEOUT_S=600

# Secondi di mancata risposta del proxy durante un task prima di marcarlo come 'lost'.
# [Overridable da GUI]
EMBERVAULT_LOST_AFTER_S=120

# Soglia del rapporto tra task previsti e proxy abilitati oltre la quale viene emesso un avviso di carico elevato.
# [Overridable da GUI]
EMBERVAULT_PARALLEL_WARN_THRESHOLD=50

# Limite hard sul numero massimo di task pianificabili senza esplicita conferma/ack.
# [Overridable da GUI]
EMBERVAULT_PARALLEL_HARD_LIMIT=500

# Timeout massimo in secondi per la fase di discovery delle cartelle sorgente.
# [Overridable da GUI]
EMBERVAULT_DISCOVERY_TIMEOUT_S=30

# Giorni di conservazione dei log dettagliati dei task nel database.
# [Overridable da GUI]
EMBERVAULT_LOG_RETENTION_DAYS=30

# Giorni di conservazione dello storico dei campionamenti di throughput nel database.
# [Overridable da GUI]
EMBERVAULT_THROUGHPUT_RETENTION_DAYS=7

# Abilita l'esecuzione di script Bash pre/post run sull'orchestrator. Per motivi di sicurezza è disabilitato per default.
# [Overridable da GUI]
EMBERVAULT_HOOKS_ENABLED=false

# Timeout massimo in secondi per l'esecuzione di ciascun hook bash (pre o post run).
# [Overridable da GUI]
EMBERVAULT_HOOKS_TIMEOUT_S=60

# URL HTTP del container sidecar dedicato hook-runner (es. http://hook-runner:8082). Se vuoto, esecuzione locale fallback.
# [Overridable da GUI]
EMBERVAULT_HOOK_RUNNER_URL=http://hook-runner:8082

# Numero predefinito di tentativi di retry per ciascun task fallito prima del fallimento permanente.
# [Overridable da GUI]
EMBERVAULT_TASK_RETRIES=2

# Numero predefinito di thread checkers paralleli per i trasferimenti RClone (--checkers).
# [Overridable da GUI]
EMBERVAULT_RCLONE_CHECKERS=8

# Numero predefinito di thread transfer contemporanei per i trasferimenti RClone (--transfers).
# [Overridable da GUI]
EMBERVAULT_RCLONE_TRANSFERS=4

# Esegue prima tutti i controlli sui file e poi avvia i trasferimenti effettivi (--check-first).
# [Overridable da GUI]
EMBERVAULT_RCLONE_CHECK_FIRST=false

# Navigazione ricorsiva delle cartelle sorgente (se disabilitato limita la profondità con --max-depth 1).
# [Overridable da GUI]
EMBERVAULT_RCLONE_RECURSE=true

# Criterio di ordinamento predefinito per i file trasferiti da RClone (--order-by, es. 'size,descending').
# [Overridable da GUI]
EMBERVAULT_RCLONE_ORDER_BY=size,descending

# Regole filtro di primo livello predefinite per includere o escludere file e cartelle nella sorgente.
# [Overridable da GUI]
EMBERVAULT_RCLONE_FIRST_LEVEL_FILTERS=- *.tmp
+ */**

# Regole filtro di secondo livello predefinite applicate ai singoli task ricavati da job con parallelizzazione attiva.
# [Overridable da GUI]
EMBERVAULT_RCLONE_SECOND_LEVEL_FILTERS=- *.bak
+ */**

# Indirizzo IP di bind per l'API interna dell'Orchestrator.
EMBERVAULT_ORCH_BIND=0.0.0.0

# Porta HTTP per l'API interna dell'Orchestrator.
EMBERVAULT_ORCH_PORT=8081

# Porta dedicata all'esposizione delle metriche Prometheus dell'Orchestrator.
EMBERVAULT_ORCH_METRICS_PORT=9091

# Intervallo in secondi del loop di valutazione delle pianificazioni cron.
# [Overridable da GUI]
EMBERVAULT_SCHEDULER_TICK_S=5

# Intervallo in secondi del loop di assegnazione e dispatch dei task pronti.
# [Overridable da GUI]
EMBERVAULT_DISPATCH_TICK_S=2

# Timeout di connessione TCP in secondi verso i proxy.
# [Overridable da GUI]
EMBERVAULT_HTTP_CONNECT_TIMEOUT_S=5

# Timeout di lettura HTTP in secondi per le risposte dei proxy.
# [Overridable da GUI]
EMBERVAULT_HTTP_READ_TIMEOUT_S=10

# Abilita i backup automatici periodici della configurazione di EmberVault.
# [Overridable da GUI]
EMBERVAULT_AUTO_BACKUP_ENABLED=false

# Espressione CRON per la frequenza dei backup automatici della configurazione.
# [Overridable da GUI]
EMBERVAULT_AUTO_BACKUP_CRON=0 3 * * *

# Chiave di crittografia per i file di backup automatico della configurazione.
# [Overridable da GUI]
# Supporta anche EMBERVAULT_AUTO_BACKUP_KEY_FILE per Docker Secrets
EMBERVAULT_AUTO_BACKUP_KEY=auto_backup_key_secret_min_32_characters

# Percorso della directory su container in cui salvare i file di backup automatico.
EMBERVAULT_AUTO_BACKUP_DIR=/backups

# Include il registro delle esecuzioni nei file di backup automatico.
# [Overridable da GUI]
EMBERVAULT_AUTO_BACKUP_INCLUDE_HISTORY=false

# Include i log di audit nei file di backup automatico.
# [Overridable da GUI]
EMBERVAULT_AUTO_BACKUP_INCLUDE_AUDIT=false

# Giorni di conservazione dei file di backup automatico in /backups.
# [Overridable da GUI]
EMBERVAULT_AUTO_BACKUP_RETENTION_DAYS=30

# Abilita l'integrazione con modelli di intelligenza artificiale per il runtime.
# [Overridable da GUI]
EMBERVAULT_AI_ENABLED=false

# Tipo di provider IA utilizzato: 'openai_compatible' o 'ollama'.
# [Overridable da GUI]
EMBERVAULT_AI_PROVIDER_TYPE=openai_compatible

# URL base dell'endpoint dell'IA (compatibile OpenAI o Ollama).
# [Overridable da GUI]
EMBERVAULT_AI_ENDPOINT_URL=http://localhost:11434

# Chiave API per l'autenticazione con il provider IA (opzionale per istanze Ollama o endpoint locali senza auth).
# [Overridable da GUI]
# Supporta anche EMBERVAULT_AI_API_KEY_FILE per Docker Secrets
EMBERVAULT_AI_API_KEY=

# Nome del modello IA da interrogare (es. 'llama3.2', 'gpt-4o-mini', 'mistral').
# [Overridable da GUI]
EMBERVAULT_AI_MODEL=llama3.2

# Timeout massimo in secondi per le richieste all'endpoint IA.
# [Overridable da GUI]
EMBERVAULT_AI_TIMEOUT_SECONDS=15

# Abilita il decision-making AI-Driven per la gestione degli errori e la valutazione di retry o fail.
# [Overridable da GUI]
EMBERVAULT_AI_ERROR_HANDLING_ENABLED=false

# Se attivo, non censura i dati sensibili (IP, host, nomi file e cartelle) prima di inviarli all'IA. Da spuntare solo se il modello gira in locale.
# [Overridable da GUI]
EMBERVAULT_AI_ERROR_HANDLING_UNCENSORED=false

# Abilita l'analisi e il riassunto AI-Driven per la reportistica e le notifiche di esecuzione (invia dati all'IA; raccomandato per modelli locali).
# [Overridable da GUI]
EMBERVAULT_AI_REPORTING_ANALYSIS_ENABLED=false

# Lingua utilizzata per le interrogazioni e le risposte generate dall'IA (default 'en').
# [Overridable da GUI]
EMBERVAULT_AI_LANGUAGE=en

# System prompt personalizzato per la valutazione e gestione degli errori da parte dell'IA. Se vuoto, usa il prompt predefinito del sistema.
# [Overridable da GUI]
EMBERVAULT_AI_SYSTEM_PROMPT=

# System prompt personalizzato per l'analisi e riassunto della reportistica di esecuzione. Se vuoto, usa il prompt predefinito del sistema.
# [Overridable da GUI]
EMBERVAULT_AI_REPORTING_SYSTEM_PROMPT=

# --- PROXY SETTINGS ---
# Token di autenticazione Bearer obbligatorio per l'accesso alle API del proxy (min 32 caratteri).
# Supporta anche TOKEN_FILE per Docker Secrets
TOKEN=proxy_auth_token_min_32_characters_secret_string

# Token precedente accettato durante la rotazione delle credenziali (zero-downtime rotation).
# Supporta anche EMBERVAULT_PROXY_PREVIOUS_TOKEN_FILE per Docker Secrets
EMBERVAULT_PROXY_PREVIOUS_TOKEN=

# Indirizzo IP di bind per il server HTTPS del proxy.
EMBERVAULT_PROXY_BIND=0.0.0.0

# Porta HTTPS del server proxy.
EMBERVAULT_PROXY_PORT=8443

# Percorso al file del certificato TLS (se omesso e auto-generazione abilitata, viene autoprodotto).
EMBERVAULT_PROXY_TLS_CERT_FILE=

# Percorso al file della chiave privata TLS.
EMBERVAULT_PROXY_TLS_KEY_FILE=

# Se True, genera automaticamente un certificato self-signed persistente al primo avvio.
# [Overridable da GUI]
EMBERVAULT_PROXY_TLS_AUTO_SELF_SIGNED=true

# Capacità massima di task RClone eseguiti contemporaneamente dal proxy.
# [Overridable da GUI]
EMBERVAULT_PROXY_MAX_CONCURRENT_TASKS=1

# Directory persistente per chiavi TLS e stato locale del proxy.
EMBERVAULT_PROXY_STATE_DIR=/var/lib/embervault/proxy

# Secondi di persistenza dei risultati dei task terminali in memoria locale del proxy.
# [Overridable da GUI]
EMBERVAULT_PROXY_RESULT_RETENTION_S=3600

# Timeout dopo il quale un task running non più interrogato dall'orchestrator viene terminato.
# [Overridable da GUI]
EMBERVAULT_PROXY_ORPHAN_TIMEOUT_S=300

# Percorso o nome dell'eseguibile RClone all'interno del container proxy.
EMBERVAULT_PROXY_RCLONE_BIN=rclone
