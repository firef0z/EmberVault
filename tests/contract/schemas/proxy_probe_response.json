{
  "additionalProperties": false,
  "description": "Response returned by POST /internal/v1/proxies/probe.",
  "properties": {
    "cert_fingerprint_sha256": {
      "description": "Canonical 64-char lowercase SHA-256 fingerprint of the proxy's TLS certificate",
      "title": "Cert Fingerprint Sha256",
      "type": "string"
    },
    "status": {
      "default": "ok",
      "description": "Probe status: 'ok' or error code",
      "title": "Status",
      "type": "string"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Observed round-trip latency in ms",
      "title": "Latency Ms"
    },
    "proxy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Remote proxy software version",
      "title": "Proxy Version"
    },
    "rclone_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Remote proxy rclone version",
      "title": "Rclone Version"
    },
    "cert_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Expiration date (UTC) of the proxy TLS certificate",
      "title": "Cert Expires At"
    }
  },
  "required": [
    "cert_fingerprint_sha256"
  ],
  "title": "ProxyProbeResponse",
  "type": "object"
}
